---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "KMX Media builds workflow websites that turn visitors into structured leads, bookings, quotes, and follow-up. Intake systems, local SEO surfaces, and practical AI agents for business operations." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased">
    <slot />
  </body>
</html>
