---
import Layout from '../layouts/Layout.astro';
import JsonLd from '../components/JsonLd.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import textureGrid from '../assets/textures/subtle-local-grid.jpg';

const title = 'KMX Media | Colorado Springs Web Design and Workflow Sites';
const description =
  'KMX Media builds Colorado Springs websites for search visibility, bookings, quote requests, customer intake, and clearer follow-up. Start a guided plan.';

const faqs = [
  {
    q: 'Do I need to know what kind of website technology I need?',
    a: 'No. Start with the business outcome, the customer action, and what is not working now. Platform and integration choices come after the requirements are clearer.',
  },
  {
    q: 'Can KMX build an ordinary business website without automation?',
    a: 'Yes. Automation, booking, and guided intake are used when they make the customer path clearer. They are not mandatory features for every project.',
  },
  {
    q: 'Is the website plan the same as a final proposal?',
    a: 'No. It is a structured preliminary direction based on the information supplied. Exact scope still depends on the business rules, content, integrations, and existing systems involved.',
  },
  {
    q: 'What if my current website is broken?',
    a: 'Begin with Website Repair and Rescue. The repair path asks about availability, symptoms, platform, timing, access, and business impact before asking new-site questions.',
  },
];

const doors = [
  { href: '/colorado-springs-web-design/', h3: 'Build or Redesign a Website' },
  { href: '/search-engine-optimization/', h3: 'Improve Search Visibility and Conversion' },
  { href: '/custom-booking-systems/', h3: 'Add Booking, Quote, or Customer Intake' },
  { href: '/website-repair-rescue/', h3: 'Repair or Take Responsibility for an Existing Site' },
];
---

<Layout title={title} description={description}>
  <JsonLd
    slot="head"
    pageUrl="/"
    pageName="Websites That Help Customers Take the Next Step"
    description={description}
    faqs={faqs}
  />

  <SiteHeader />

  <main id="top" class="kmx-page relative overflow-x-clip" style={`--texture-url: url(${textureGrid.src});`}>
    <div class="pointer-events-none absolute inset-0 bg-[image:var(--texture-url)] bg-[length:520px_auto] opacity-[0.035]"></div>

    <header class="kmx-section kmx-section--hero">
      <div class="kmx-section-inner grid gap-10 py-14 md:py-20 lg:grid-cols-[1fr_0.85fr] lg:items-center">
        <div>
          <p class="kmx-eyebrow">Colorado Springs web design</p>
          <h1 class="kmx-display mt-5 max-w-4xl text-4xl sm:text-5xl md:text-6xl">
            Websites That Help Customers Take the Next Step
          </h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-[var(--kmx-body-2)]">
            KMX Media designs and develops websites for Colorado Springs service businesses. We build new sites,
            redesign websites that are not producing enough action, improve search visibility, and repair websites
            that have become broken or difficult to manage.
          </p>
          <p class="mt-4 max-w-3xl text-base leading-7 text-[var(--kmx-body-2)]">
            The work begins with the result the business needs: more qualified calls, clearer quote requests, easier
            scheduling, better customer intake, or a dependable path from local search to the next action. If you are
            specifically comparing local designers, visit
            <a class="font-semibold text-[var(--kmx-copper-deep)] underline decoration-[var(--kmx-peach-line)] underline-offset-2" href="/colorado-springs-web-design/">Colorado Springs Web Design</a>.
            If the website already exists but needs help, begin with
            <a class="font-semibold text-[var(--kmx-copper-deep)] underline decoration-[var(--kmx-peach-line)] underline-offset-2" href="/website-repair-rescue/">Website Repair and Rescue</a>.
          </p>
          <div class="mt-8">
            <a href="/start/" class="kmx-btn-primary kmx-focus-visible w-full sm:w-auto">Start My Website Plan</a>
          </div>
        </div>
        <MediaPlaceholder
          kind="image"
          label="image: intake answers becoming a recommended website plan"
          overlay="Your answers become a visible website plan - not a message sent into a contact form."
        />
      </div>
    </header>

    <section id="doors" class="kmx-section kmx-section--outcome-cards kmx-band-paper">
      <div class="kmx-section-inner py-12 md:py-16">
        <p class="kmx-eyebrow">four doors</p>
        <h2 class="kmx-h2 mt-3 text-3xl md:text-5xl">What Does Your Website Need to Do?</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-2">
          {doors.map((door) => (
            <article class="kmx-card">
              <h3 class="text-xl font-black tracking-[-0.02em] text-[var(--kmx-ink)]">{door.h3}</h3>
              <a class="mt-4 inline-block font-semibold text-[var(--kmx-copper-deep)]" href={door.href}>Continue</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="kmx-section kmx-section--split-media kmx-section-inner py-12 md:py-16">
      <div class="kmx-split">
        <div>
          <p class="kmx-eyebrow">conversion</p>
          <h2 class="kmx-h2 text-3xl md:text-5xl">More Than a Digital Business Card</h2>
          <p class="mt-4 text-lg leading-8 text-[var(--kmx-body-2)]">
            Many business websites function as digital business cards. They name the services, show a telephone
            number, and leave the customer to work out everything else. That can be enough when every project
            requires a conversation, but it creates unnecessary friction when customers could answer basic questions,
            see the available path, request the right service, or begin scheduling on their own.
          </p>
          <h3 class="mt-6 text-lg font-black text-[var(--kmx-ink)]">Give Customers a Clear Next Action</h3>
          <p class="mt-2 text-base leading-7 text-[var(--kmx-body-2)]">
            KMX builds customer paths into the website itself. A site can help visitors choose the right service,
            provide the details needed for a useful quote, request an appointment, understand what happens next, or
            receive a faster first response.
          </p>
          <h3 class="mt-6 text-lg font-black text-[var(--kmx-ink)]">Collect Better Information Before Follow-Up</h3>
          <p class="mt-2 text-base leading-7 text-[var(--kmx-body-2)]">
            Search optimization brings the right visitor to the page; conversion design helps that visitor continue.
          </p>
          <h3 class="mt-6 text-lg font-black text-[var(--kmx-ink)]">Reduce Repetitive Back-and-Forth</h3>
          <p class="mt-2 text-base leading-7 text-[var(--kmx-body-2)]">
            That is why KMX keeps four needs distinct:
            <a class="font-semibold text-[var(--kmx-copper-deep)]" href="/colorado-springs-web-design/">web design</a>,
            <a class="font-semibold text-[var(--kmx-copper-deep)]" href="/search-engine-optimization/">search visibility</a>,
            <a class="font-semibold text-[var(--kmx-copper-deep)]" href="/custom-booking-systems/">booking and intake systems</a>,
            and
            <a class="font-semibold text-[var(--kmx-copper-deep)]" href="/website-repair-rescue/">website rescue</a>.
            They can work together without becoming one vague service package.
          </p>
        </div>
        <MediaPlaceholder
          kind="image"
          label="image: customer actions supported by a workflow website"
          overlay="Search visibility is only the entrance. The website still needs a clear path into calls, bookings, quotes, or intake."
        />
      </div>
    </section>

    <section class="kmx-section kmx-section--cta-band">
      <div class="mx-auto max-w-4xl">
        <p class="kmx-eyebrow-on-ink">living project brief</p>
        <h2 class="kmx-h2 mt-3 text-3xl text-[var(--kmx-cream)] md:text-5xl">Your Plan Assembles as You Answer</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg leading-8 text-[#dbe4df]">
          <a class="font-semibold text-white underline decoration-[var(--kmx-peach-line)] underline-offset-2" href="/start/">Start My Website Plan</a>
          opens a living project brief. Choose the situation closest to yours - new website, redesign, visibility and
          conversion, booking or intake system, or website repair. The plan carries that problem family forward, asks
          only the next useful questions, and assembles a preliminary direction from your answers.
        </p>
        <p class="mx-auto mt-4 max-w-2xl text-sm leading-6 text-[#c9d4ce]">
          You do not need to know which platform, integration, or technical service to request. Begin with what the
          website needs to accomplish. The brief will organize the known facts, show what remains unanswered, and
          prepare a cleaner starting point for the next conversation.
        </p>
        <div class="mx-auto mt-8 max-w-xl">
          <MediaPlaceholder
            kind="video"
            label="video: four KMX service entrances feeding one living project brief"
            overlay="Four ways in. One project brief that remembers why you came."
          />
        </div>
        <a href="/start/" class="kmx-btn-primary kmx-focus-visible-dark mt-8 w-full sm:w-auto">Start My Website Plan</a>
      </div>
    </section>

    <section class="kmx-section kmx-section-inner py-12 md:py-16">
      <p class="kmx-eyebrow">proof</p>
      <h2 class="kmx-h2 mt-3 text-3xl md:text-5xl">Selected KMX Work</h2>
      <p class="mt-4 max-w-2xl text-base leading-7 text-[var(--kmx-body-2)]">
        Examples of customer-path websites live on the work page. This homepage does not invent case-study claims.
      </p>
      <a class="mt-4 inline-block font-semibold text-[var(--kmx-copper-deep)]" href="/work/">Work and case studies</a>
    </section>

    <section id="faq" class="kmx-section kmx-section--faq kmx-section-inner pb-16">
      <p class="kmx-eyebrow">FAQ</p>
      <h2 class="kmx-h2 mt-3 text-3xl md:text-5xl">Start With the Problem You Already Know</h2>
      <div class="mt-8 grid gap-4 lg:grid-cols-2">
        {faqs.map((item) => (
          <details class="kmx-faq-item group">
            <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 font-bold text-[var(--kmx-ink)] marker:hidden">
              <span>{item.q}</span>
              <span class="text-xl leading-none text-[var(--kmx-copper)] transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-sm leading-6 text-[var(--kmx-body-2)]">{item.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
