---
const siteUrl = (Astro.site?.toString() || 'https://kmxmedia.com').replace(/\/$/, '');
const orgId = `${siteUrl}/#organization`;
const siteId = `${siteUrl}/#website`;
const pageId = `${siteUrl}/#webpage`;
const faqId = `${siteUrl}/#faq`;

const faqItems = [
  {
    question: 'What does a Minnesota small business website need to do today?',
    answer:
      'It should help drive calls, bookings, quote requests, customer intake, and follow-up. Looking modern is useful, but the site also needs to move work forward.',
  },
  {
    question: 'Do I need both a website and a Google Business Profile?',
    answer:
      'Usually yes. Google Business Profile helps people find you. The website gives those visitors a clearer path to call, book, request a quote, or send complete details.',
  },
  {
    question: 'Can you build a website that books appointments, rides, or consultations?',
    answer:
      'Yes. If booking is part of the workflow, the recommended plan can include a booking or scheduling flow.',
  },
  {
    question: 'Can you add quote request or customer intake forms?',
    answer:
      'Yes. Quote and intake forms are core parts of the workflow website model when your team needs better details before responding.',
  },
  {
    question: 'What is a workflow website?',
    answer:
      'A workflow website is built around customer actions: collecting the right details, routing them, following up, and making the next step clearer for both sides.',
  },
  {
    question: 'What do AI workflow agents do?',
    answer:
      'They can help with first response, missing-info collection, lead qualification, reminders, FAQ replies, and handoff summaries, with human oversight.',
  },
  {
    question: 'Can you improve my current site instead of rebuilding?',
    answer:
      'Sometimes. If the current structure can support the workflows you need, optimization may work. If not, a focused rebuild may be faster and clearer.',
  },
  {
    question: 'How long does this take?',
    answer:
      'Timeline is blocked until scope is known. The intake gives enough detail to recommend a launch path and discuss timing.',
  },
];

const services = [
  {
    name: 'Minnesota Workflow Website Design',
    serviceType: 'Web design / workflow website design',
    description:
      'Website design for Minnesota local service businesses, focused on calls, bookings, quote requests, customer intake, follow-up, and cleaner lead details.',
  },
  {
    name: 'Local SEO and Google Business Profile Conversion',
    serviceType: 'Local SEO / GBP conversion',
    description:
      'Website-side local conversion support that helps Google Business Profile visitors move into calls, clicks, bookings, quote requests, or intake details.',
  },
  {
    name: 'Booking, Quote Request, and Customer Intake Systems',
    serviceType: 'Booking / quote / customer intake systems',
    description:
      'Website workflows for appointment scheduling, ride or reservation requests, quote requests, project details, new-client intake, event inquiries, confirmations, and handoff language.',
  },
  {
    name: 'Workflow Automation and AI Workflow Agents',
    serviceType: 'Workflow automation / AI workflow agents',
    description:
      'Practical AI workflow agents and automations for first response, missing-info collection, lead qualification, routing, reminders, customer intake, and clean human handoff.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: 'KMX Media',
      url: siteUrl,
      description:
        'KMX Media builds Minnesota workflow websites focused on calls, bookings, quote requests, customer intake, follow-up, local SEO / Google Business Profile conversion, workflow automation, practical AI workflow agents, and urgent WordPress repairs.',
    },
    {
      '@type': 'WebSite',
      '@id': siteId,
      url: siteUrl,
      name: 'KMX Media',
      publisher: {
        '@id': orgId,
      },
    },
    {
      '@type': 'WebPage',
      '@id': pageId,
      url: siteUrl,
      name: 'Local Web Design for Minnesota Businesses That Need More Leads',
      isPartOf: {
        '@id': siteId,
      },
      about: {
        '@id': orgId,
      },
      description:
        'A Minnesota local web design homepage where the intake form and live recommendation panel assemble a workflow website plan for calls, bookings, quote requests, customer intake, local SEO / GBP conversion, automation, AI follow-up, and urgent repairs.',
    },
    ...services.map((service) => ({
      '@type': 'Service',
      name: service.name,
      serviceType: service.serviceType,
      provider: {
        '@id': orgId,
      },
      description: service.description,
    })),
    {
      '@type': 'FAQPage',
      '@id': faqId,
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
