---
interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  pageUrl: string;
  pageName: string;
  description: string;
  faqs?: FaqItem[];
}

const { pageUrl, pageName, description, faqs = [] } = Astro.props;
const siteUrl = (Astro.site?.toString() || 'https://kmxmedia.com').replace(/\/$/, '');
const orgId = `${siteUrl}/#organization`;
const canonical = pageUrl.startsWith('http') ? pageUrl : `${siteUrl}${pageUrl}`;

const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': orgId,
    name: 'KMX Media',
    url: siteUrl,
    telephone: '+1-507-602-2949',
    email: 'webdev@starglassdigital.com',
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: pageName,
    isPartOf: { '@type': 'WebSite', url: siteUrl, name: 'KMX Media' },
    about: { '@id': orgId },
    description,
  },
];

if (faqs.length > 0) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  });
}

const schema = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
